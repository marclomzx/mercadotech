# Supabase — proyecto en https://supabase.com/dashboard, sección Project Settings > API.
# URL pública del proyecto Supabase. Segura de exponer al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (anon/public). Segura de exponer al navegador: el acceso real
# lo controla RLS en la base de datos, no esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de service role. BYPASEA Row Level Security por completo.
# NUNCA exponerla al navegador ni prefijarla con NEXT_PUBLIC_.
# Solo la usa lib/supabase/admin.ts, exclusivamente en servidor.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para redirects de auth, links en emails, etc.).
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hugging Face (sesión 4). Token de tipo "Read" creado en
# https://huggingface.co/settings/tokens — empieza con hf_.
# Solo servidor: NUNCA prefijarlo con NEXT_PUBLIC_ (expondría la cuota de la
# cuenta a cualquiera que abra el sitio).
HUGGINGFACEHUB_API_TOKEN=

# Modelo de embeddings. OPCIONAL: si se omite, el código usa
# sentence-transformers/all-MiniLM-L6-v2 (384 dimensiones).
# ⚠️ Cambiar a un modelo con otra dimensión NO basta con esta variable:
# la columna vector(384) exige una migración (ALTER COLUMN + recrear índice).
HUGGINGFACE_EMBEDDING_MODEL=

# Modelo de chat. OPCIONAL: si se omite, el código usa el default.
# La disponibilidad de modelos gratuitos ROTA: si el proveedor deja de
# servir el modelo actual, se reemplaza SOLO con esta variable, sin tocar
# código. Probar el candidato contra la API antes de fijarlo.
HUGGINGFACE_CHAT_MODEL=
